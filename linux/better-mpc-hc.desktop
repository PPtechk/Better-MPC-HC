[Desktop Entry]
Type=Application
Name=Better MPC-HC
GenericName=Media Player
Comment=Video and audio player with a Skip Intro/Outro button and volume up to 200%
Exec=better-mpc-hc %F
Icon=better-mpc-hc
Terminal=false
Categories=AudioVideo;Video;Player;
Keywords=video;movie;audio;player;mpc;mpc-hc;
StartupWMClass=better-mpc-hc64.exe
MimeType=video/x-matroska;video/mp4;video/x-m4v;video/webm;video/x-msvideo;video/avi;video/quicktime;video/mpeg;video/mp2t;video/x-flv;video/x-ms-wmv;video/x-ms-asf;video/ogg;video/3gpp;video/3gpp2;audio/x-matroska;audio/mpeg;audio/mp4;audio/aac;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-wav;audio/wav;audio/x-ms-wma;
