# Local build override (not part of the MPC-HC sources):
# the Windows 7.1A SDK required by v140_xp and the Windows 8.1 SDK are not available
# with the VS 2019 Build Tools, so build with v140 against the installed Windows 10 SDK.
/p:PlatformToolset=v140
/p:WindowsTargetPlatformVersion=10.0.19041.0
